# PostgreSQL used by docker-compose.yml
POSTGRES_DB=timberops
POSTGRES_USER=timberops
# Replace this value in .env. Never use the example value outside local development.
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
APP_ENV=development
APP_NAME=TimberOps backend
DEBUG=true
APP_SECRET_KEY=replace_with_a_long_random_value
DATABASE_URL=postgresql+psycopg://timberops:change_me_for_local_development@localhost:5432/timberops

# Frontend (will be consumed from Phase 1)
VITE_API_BASE_URL=http://localhost:8000/api/v1
