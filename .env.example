# TimberOps environment template
#
# Local development:
#   APP_ENV=development and DEBUG=true. Set ENABLE_API_DOCS=true when needed.
#   An empty CORS value enables only localhost:5173 and 127.0.0.1:5173 in the
#   development profile. Vite normally proxies relative /api requests.
# Production:
#   APP_ENV is forced to production and DEBUG=false by docker-compose.prod.yml.
#   Keep API docs and public registration disabled unless explicitly required.
#   Same-origin Nginx deployments need no CORS origins; split-origin deployments
#   must list only their exact HTTPS frontend origins.

# PostgreSQL used by docker-compose.yml
POSTGRES_DB=timberops
POSTGRES_USER=timberops
# Replace this value in .env. Never use the example value outside local development.
POSTGRES_PASSWORD=GvuG1qt7IFpoQsmOd_q5gfd9XcTvlVizOxFA7_ok-ss
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
APP_ENV=development
APP_NAME=TimberOps backend
DEBUG=true
ENABLE_API_DOCS=false
# Enables the unauthenticated Prometheus scrape endpoint at backend /metrics.
# In production, expose it only on a trusted internal network.
ENABLE_METRICS=true
# Optional explicit development allowlist:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=
# Generate a unique random value of at least 32 characters for every deployment.
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
SLOW_REQUEST_THRESHOLD_MS=1000
# Set true only when self-registration is intentionally enabled.
PUBLIC_REGISTRATION_ENABLED=false
DATABASE_URL=postgresql+psycopg://timberops:change_me_for_local_development@localhost:5432/timberops
# Production Compose override. URL-encode special characters in the password.
# The database hostname must remain "db" inside the Compose network.
DATABASE_URL_DOCKER=postgresql+psycopg://timberops:GvuG1qt7IFpoQsmOd_q5gfd9XcTvlVizOxFA7_ok-ss@db:5432/timberops

# Frontend
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=8080

# Read-only AI Agent (disabled unless explicitly configured)
AI_ENABLED=false
LLM_PROVIDER=doubao
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODEL=
AI_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
AI_AGENT_TIMEOUT_SECONDS=30

# Read-only MCP Server (Streamable HTTP)
MCP_HOST=127.0.0.1
MCP_PORT=8001
# Loopback-only by default. Set 0.0.0.0 only when remote MCP access is intended
# and protected by appropriate host firewall/network controls.
MCP_BIND_ADDRESS=127.0.0.1
